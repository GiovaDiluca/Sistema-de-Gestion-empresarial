<NominaScreen>:

    BoxLayout:
        orientation: "horizontal"
        padding: 15
        spacing: 15

        # 🔹 PANEL IZQUIERDO (FORMULARIO)
        BoxLayout:
            orientation: "vertical"
            size_hint_x: 0.35
            spacing: 10

            Label:
                text: "MÓDULO DE NÓMINA"
                font_size: 20

            Spinner:
                id: spinner_empleados
                text: "Seleccione empleado"

            Spinner:
                id: spinner_periodo
                text: "Seleccione período"
                values: ["Semanal", "Quincenal", "Mensual"]

            MDRaisedButton:
                id: btn_fecha
                text: "Seleccione fecha"
                on_release: root.mostrar_calendario()

            Button:
                text: "Calcular"
                on_release: root.calcular()

            Button:
                text: "Guardar Nómina"
                on_release: root.guardar()

            Button:
                text: "Generar PDF"
                on_release: root.generar_pdf()

            Button:
                text: "Volver"
                on_release: root.volver()

        # 🔹 PANEL DERECHO (RECIBO)
        BoxLayout:
            orientation: "vertical"
            spacing: 8

            Label:
                id: encabezado_nomina
                text: ""
                bold: True
                size_hint_y: None
                height: 40

            Label:
                text: "SUELDO BASE"
                bold: True

            Label:
                id: sueldo_base_lbl
                text: ""

            Label:
                text: "INGRESOS"
                bold: True

            ScrollView:
                size_hint_y: 0.3
                GridLayout:
                    id: tabla_ingresos
                    cols: 2
                    size_hint_y: None
                    height: self.minimum_height
                    row_default_height: 35
                    row_force_default: True

            Label:
                text: "DEDUCCIONES"
                bold: True

            ScrollView:
                size_hint_y: 0.3
                GridLayout:
                    id: tabla_deducciones
                    cols: 2
                    size_hint_y: None
                    height: self.minimum_height
                    row_default_height: 35
                    row_force_default: True

            Label:
                id: resumen_totales
                text: ""
                bold: True
                size_hint_y: None
                height: 60