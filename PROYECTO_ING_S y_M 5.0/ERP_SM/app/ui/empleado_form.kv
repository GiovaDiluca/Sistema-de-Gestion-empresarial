<EmpleadoFormScreen>:
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: app.theme_cls.bg_light
        
        MDTopAppBar:
            title: "Registro de Empleado"
            elevation: 2
            left_action_items: [["arrow-left", lambda x: root.volver()]]

        MDBoxLayout:
            padding: "20dp"
            
            MDCard:
                orientation: "vertical"
                padding: "24dp"
                spacing: "15dp"
                elevation: 3
                radius: [15, 15, 15, 15]

                MDLabel:
                    text: "Datos del Empleado"
                    font_style: "H6"
                    size_hint_y: None
                    height: "30dp"
                    
                MDLabel:
                    id: lbl_estado
                    text: ""
                    theme_text_color: "Error"
                    size_hint_y: None
                    height: "15dp"

                ScrollView:
                    MDGridLayout:
                        cols: 1
                        spacing: "15dp"
                        size_hint_y: None
                        height: self.minimum_height
                        padding: ["10dp", "10dp", "10dp", "10dp"]

                        MDTextField:
                            id: input_nombre
                            hint_text: "Nombre"
                            mode: "rectangle"

                        MDTextField:
                            id: input_apellido
                            hint_text: "Apellido"
                            mode: "rectangle"

                        MDTextField:
                            id: input_cedula
                            hint_text: "Cédula"
                            mode: "rectangle"

                        MDTextField:
                            id: input_telefono
                            hint_text: "Teléfono"
                            mode: "rectangle"

                        MDTextField:
                            id: input_email
                            hint_text: "Email"
                            mode: "rectangle"

                        MDTextField:
                            id: input_nivel
                            hint_text: "Nivel de instrucción"
                            mode: "rectangle"

                        MDTextField:
                            id: input_puesto
                            hint_text: "Puesto"
                            mode: "rectangle"

                        MDTextField:
                            id: input_salario
                            hint_text: "Salario"
                            input_filter: "float"
                            mode: "rectangle"

                        MDTextField:
                            id: input_fecha
                            hint_text: "Fecha ingreso (YYYY-MM-DD)"
                            mode: "rectangle"

                MDRaisedButton:
                    text: "Guardar Información"
                    size_hint_x: 1
                    elevation: 2
                    on_release: root.guardar()
